---
/**
 * Landing page — Post Event Portal
 */

import Layout from '../layouts/Layout.astro';
import editionData from '../content/edition-no-01.json';

import '../styles/global.css';

// Gallery photos kept here — uncomment Gallery below to restore the event photo grid.
// import Gallery from '../components/Gallery.astro';

import { readdirSync } from 'node:fs';
import { resolve } from 'node:path';
const eventDir = resolve('./public/assets/photos/event');
const igPhotos = readdirSync(eventDir)
  .filter(f => /\.(jpe?g|png|webp)$/i.test(f))
  .sort()
  .slice(0, 12)
  .map(f => `/assets/photos/event/${f}`);
---

<Layout
  title="GILD — Post Event Portal"
  description="We truly appreciated having you at this GILD Edition."
>
  <!-- 01. HERO -->
  <section class="hero-section">
    <div class="hero-top">
      <img src="/assets/logos/logo-gild.png" alt="GILD" class="gild-logo" />
      <p class="hero-eyebrow text-eyebrow">AI Forum</p>
    </div>

    <div class="hero-center">
      <h1 class="hero-title">
        <span class="block overflow-hidden">
          <span class="hero-line block">Thanks for</span>
        </span>
        <span class="block overflow-hidden">
          <span class="hero-line block">joining us!</span>
        </span>
      </h1>
    </div>

    <div class="hero-bottom">
      <p class="hero-partner-label text-body-s">Presented in partnership with</p>
      <a href="https://www.tecla.io/" target="_blank" rel="noopener" class="partner-link">
        <img src="/assets/logos/tecla.png" alt="Tecla" class="partner-logo" />
      </a>
      <svg class="hero-scroll-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </div>
  </section>

  <!-- 02. GALLERY — kept, uncomment to restore event photo grid
  <Gallery
    eyebrow={editionData.gallery.eyebrow}
    photos={allEventPhotos}
  />
  -->
  
  <!-- 03. NEXT EVENT — kept, add back when needed
  <section class="next-event-wrapper">
    <div class="next-event-header">
      <h2 class="text-display-m" style="color: var(--color-fg); text-align: center;">
        Next Event GILD Austin
      </h2>
    </div>
    <div class="next-event-content">
      <a href="https://luma.com/GILD23" target="_blank" rel="noopener" class="next-event-link">
        <img src="/assets/photos/events/gild23.png" alt="Next Event GILD AI Forum" class="next-event-image" />
        <div class="next-event-overlay">
          <span class="text-button">RSVP ON LUMA →</span>
        </div>
      </a>
    </div>
  </section>
  -->

  <!-- 03. INSTAGRAM — live feed, instagram.com grid style -->
  <!--
    ACTIVATE FEED (one-time, ~5 min):
    1. behold.so → sign up → connect @gild.hq
    2. Create widget → Grid · Square · 3 columns · no captions · no border-radius
    3. Copy Widget ID → replace BEHOLD_WIDGET_ID below
    Feed auto-updates with every new post.
  -->
  <section class="ig-section" aria-label="Follow GILD on Instagram">

    <!-- Profile header — like instagram.com -->
    <div class="ig-profile">
      <svg class="ig-avatar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
        <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
      </svg>
      <div class="ig-profile-text">
        <a
          href="https://www.instagram.com/gild.hq/"
          target="_blank"
          rel="noopener"
          class="ig-username"
          aria-label="Open @gild.hq on Instagram"
        >@gild.hq →</a>
        <p class="ig-bio text-body-s" style="color: var(--color-fg-muted);">Private B2B operator community · Austin</p>
      </div>
    </div>

    <!--
      Local event images render first so the section stays useful without the API.
      The client script below replaces them with the latest @gild.hq media when
      /api/ig-feed has been configured in Cloudflare Pages.
    -->
    <div class="ig-feed" data-ig-feed aria-live="polite">
      {igPhotos.map(src => (
        <a href="https://www.instagram.com/gild.hq/" target="_blank" rel="noopener" class="ig-post" aria-label="GILD on Instagram">
          <img src={src} alt="GILD Miami AI Forum" loading="lazy" decoding="async" />
        </a>
      ))}
    </div>

  </section>


</Layout>

<style>
  /* ── HERO ── */
  .hero-section {
    min-height: 85vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    gap: 24px;
    padding: 48px 24px;
    box-sizing: border-box;
  }

  .hero-top {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .gild-logo {
    height: 42px;
    width: auto;
    filter: brightness(0) invert(1);
  }

  .hero-eyebrow {
    color: #7ec8b8;
    margin: 0;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-size: 12px;
    font-weight: 400;
  }

  .hero-center {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }

  .hero-title {
    font-family: 'Montserrat', sans-serif;
    font-weight: 300;
    font-size: clamp(1.8rem, 5.6vw, 4.4rem);
    line-height: 1.15;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-fg);
    margin: 0;
    max-width: 1000px;
  }

  .hero-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .hero-partner-label {
    color: var(--color-fg-muted);
    margin: 0;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-size: 14px;
    font-weight: 400;
  }

  .partner-link {
    display: inline-block;
    transition: opacity var(--duration-hover) var(--ease-entrance);
  }

  .partner-link:hover {
    opacity: 0.8;
  }

  .partner-logo {
    height: 44px;
    width: auto;
  }

  .hero-scroll-arrow {
    color: var(--color-fg-muted);
    margin-top: 12px;
    animation: hero-bounce 2s ease-in-out infinite;
    width: 28px;
    height: 28px;
  }

  @keyframes hero-bounce {
    0%, 100% { transform: translateY(0); opacity: 0.5; }
    50% { transform: translateY(8px); opacity: 0.9; }
  }

  /* ── INSTAGRAM — instagram.com grid style ── */
  .ig-section {
    padding-top: 24px;
    padding-bottom: 0;
  }

  /* Profile header row */
  .ig-profile {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    padding: 0 24px 24px;
    max-width: 935px;
    margin: 0 auto;
  }

  .ig-avatar-icon {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    color: var(--color-fg-muted);
  }

  .ig-profile-text {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .ig-username {
    font-size: 17px;
    font-weight: 500;
    color: var(--color-fg);
    text-decoration: none;
    letter-spacing: -0.01em;
    transition: color var(--duration-hover) var(--ease-entrance);
  }

  .ig-username:hover {
    color: var(--color-accent);
  }

  .ig-bio {
    margin: 0;
  }

  /* Feed — full-bleed, 3 cols, 3px gap like instagram.com */
  .ig-feed {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3px;
    width: 100%;
    max-width: 935px;
    margin: 0 auto;
  }

  .ig-post {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--color-surface, #111);
  }

  .ig-post img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.2s ease;
  }

  .ig-post:hover img {
    opacity: 0.82;
  }


  @media (min-width: 768px) {
    .ig-section {
      padding-top: 32px;
    }

    .ig-profile {
      padding: 0 0 28px;
      gap: 24px;
    }

    .ig-avatar-icon {
      width: 64px;
      height: 64px;
    }

    .ig-username {
      font-size: 20px;
    }
  }

  /* ── NEXT EVENT WRAPPER (kept for reuse) ── */
  .next-event-wrapper {
    padding: 64px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
  }

  .next-event-header {
    max-width: 480px;
    margin: 0 auto;
  }

  .next-event-content {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
  }

  .next-event-link {
    display: block;
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    transition: transform var(--duration-hover) var(--ease-entrance);
  }

  .next-event-link:hover {
    transform: scale(1.02);
  }

  .next-event-image {
    width: 100%;
    height: auto;
    display: block;
  }

  .next-event-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--duration-hover) var(--ease-entrance);
  }

  .next-event-link:hover .next-event-overlay {
    opacity: 1;
  }

  .text-button {
    color: white;
    font-family: var(--font-body);
    font-size: 14px;
    letter-spacing: 0.1em;
    font-weight: 500;
    padding: 12px 24px;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(4px);
  }

  /* ── Mobile: fit hero in 100vh ── */
  @media (max-width: 767px) {
    .hero-section {
      min-height: 85vh;
      min-height: 85dvh;
      padding: 48px 20px;
    }

    .hero-top {
      gap: 14px;
    }

    .gild-logo {
      height: 28px;
    }

    .hero-eyebrow {
      font-size: 10px;
    }

    .hero-center {
      padding: 20px 0;
    }

    .hero-title {
      font-size: 1.6rem;
    }

    .hero-bottom {
      gap: 8px;
    }

    .hero-partner-label {
      font-size: 9px;
    }

    .sponsor-logo {
      height: 28px;
    }

    .hero-scroll-arrow {
      margin-top: 16px;
      width: 22px;
      height: 22px;
    }
  }

  /* ── Desktop ── */
  @media (min-width: 768px) {
    .hero-section {
      padding: 96px 64px;
    }
  }
</style>

<script>
  import { animateCoverTitle, animateFadeUp } from '../lib/gsap-utils';

  document.addEventListener('DOMContentLoaded', () => {
    // Hero Entrance
    animateCoverTitle('.hero-section', '.hero-line');
    animateFadeUp('.hero-section', '.hero-top, .hero-bottom', {
      stagger: 0.15,
      delay: 0.4,
    });

    // Instagram section entrance
    animateFadeUp('.ig-section', '.ig-profile, .ig-feed', { stagger: 0.15 });

    const feed = document.querySelector('[data-ig-feed]');
    if (!feed) return;

    fetch('/api/ig-feed')
      .then((response) => {
        if (!response.ok) throw new Error('Instagram feed unavailable');
        return response.json();
      })
      .then(({ posts }) => {
        if (!Array.isArray(posts) || posts.length === 0) return;

        const fragment = document.createDocumentFragment();

        posts.forEach((post) => {
          if (!post?.img || !post?.url) return;

          const link = document.createElement('a');
          link.href = post.url;
          link.target = '_blank';
          link.rel = 'noopener';
          link.className = 'ig-post';
          link.setAttribute('aria-label', 'Open post from @gild.hq on Instagram');

          const image = document.createElement('img');
          image.src = post.img;
          image.alt = 'Latest post from GILD on Instagram';
          image.loading = 'lazy';
          image.decoding = 'async';

          link.append(image);
          fragment.append(link);
        });

        if (fragment.childNodes.length > 0) {
          feed.replaceChildren(fragment);
        }
      })
      .catch(() => {
        // Keep the server-rendered event gallery as the graceful fallback.
      });
  });
</script>
