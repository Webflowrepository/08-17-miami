---
/**
 * Landing page — Post Event Portal
 */

import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

const instagramPosts = [
  { src: '/assets/instagram/post-01.jpg', url: 'https://www.instagram.com/gild.hq/reel/DcMKeHBAU3I/' },
  { src: '/assets/instagram/post-02.jpg', url: 'https://www.instagram.com/gild.hq/p/DcAFVOKHNaa/' },
  { src: '/assets/instagram/post-03.jpg', url: 'https://www.instagram.com/gild.hq/p/DbuDyEcnNAM/' },
  { src: '/assets/instagram/post-04.jpg', url: 'https://www.instagram.com/gild.hq/reel/DbmNsS9Efoq/' },
  { src: '/assets/instagram/post-05.jpg', url: 'https://www.instagram.com/gild.hq/reel/DbTnKxvIJuw/' },
  { src: '/assets/instagram/post-06.jpg', url: 'https://www.instagram.com/gild.hq/reel/DbMPbsKj9g4/' },
  { src: '/assets/instagram/post-07.jpg', url: 'https://www.instagram.com/gild.hq/p/DbEpUy-IMd0/' },
  { src: '/assets/instagram/post-08.jpg', url: 'https://www.instagram.com/gild.hq/p/Da7GMLDncr8/' },
  { src: '/assets/instagram/post-09.jpg', url: 'https://www.instagram.com/gild.hq/reel/DamEXZ1ia1b/' },
];

// Gallery photos kept here — uncomment Gallery below to restore the event photo grid.
// import Gallery from '../components/Gallery.astro';

---

<Layout
  title="GILD — Post Event Portal"
  description="We truly appreciated having you at this GILD Edition."
>
  <!-- 01. HERO -->
  <section class="hero-section">
    <div class="hero-top">
      <img src="/assets/logos/logo-gild.png" alt="GILD" class="gild-logo" />
      <p class="hero-eyebrow text-eyebrow">AI Forum</p>
    </div>

    <div class="hero-center">
      <h1 class="hero-title">
        <span class="block overflow-hidden">
          <span class="hero-line block">Thanks for</span>
        </span>
        <span class="block overflow-hidden">
          <span class="hero-line block">joining us!</span>
        </span>
      </h1>
    </div>

    <div class="hero-bottom">
      <p class="hero-partner-label text-body-s">Presented in partnership with</p>
      <a href="https://www.tecla.io/" target="_blank" rel="noopener" class="partner-link">
        <img src="/assets/logos/new%20tecla.png" alt="Tecla Labs" class="partner-logo" />
      </a>
      <svg class="hero-scroll-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </div>
  </section>

  <!-- 02. GALLERY — kept, uncomment to restore event photo grid
  <Gallery
    eyebrow={editionData.gallery.eyebrow}
    photos={allEventPhotos}
  />
  -->
  
  <!-- 03. NEXT EVENT — kept, add back when needed
  <section class="next-event-wrapper">
    <div class="next-event-header">
      <h2 class="text-display-m" style="color: var(--color-fg); text-align: center;">
        Next Event GILD Austin
      </h2>
    </div>
    <div class="next-event-content">
      <a href="https://luma.com/GILD23" target="_blank" rel="noopener" class="next-event-link">
        <img src="/assets/photos/events/gild23.png" alt="Next Event GILD AI Forum" class="next-event-image" />
        <div class="next-event-overlay">
          <span class="text-button">RSVP ON LUMA →</span>
        </div>
      </a>
    </div>
  </section>
  -->

  <!-- 03. INSTAGRAM — latest posts from @gild.hq -->
  <section class="ig-section" aria-label="Follow GILD on Instagram">
    <div class="ig-grid">
      {instagramPosts.map((post) => (
        <a href={post.url} target="_blank" rel="noopener" class="ig-post" aria-label="Open GILD post on Instagram">
          <img src={post.src} alt="GILD Instagram post" loading="lazy" decoding="async" />
        </a>
      ))}
    </div>
    <div class="ig-cta">
      <p class="ig-cta-copy">More from the room</p>
      <a class="ig-logo-cta" href="https://www.instagram.com/gild.hq/" target="_blank" rel="noopener" aria-label="Open @gild.hq on Instagram">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2.5" y="2.5" width="19" height="19" rx="5"/>
          <circle cx="12" cy="12" r="4.2"/>
          <circle cx="17.6" cy="6.5" r="0.7" fill="currentColor" stroke="none"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- 04. NEXT EVENT -->
  <section class="next-event-wrapper" aria-label="Next GILD event">
    <div class="next-event-header">
      <p class="text-eyebrow next-event-label">Next event</p>
      <p class="next-event-city">Miami · Coral Gables</p>
      <p class="next-event-date">Tuesday, October 6 · 6:00 PM</p>
    </div>
    <div class="next-event-content">
      <a href="https://luma.com/GILD29" target="_blank" rel="noopener" class="next-event-link" aria-label="Open Miami GILD AI Forum on Luma">
        <img src="/assets/events/gild29.png" alt="Miami GILD AI Forum x Tecla" class="next-event-image" loading="lazy" decoding="async" />
        <div class="next-event-overlay" aria-hidden="true">
          <span class="text-button">VIEW EVENT ON LUMA →</span>
        </div>
      </a>
    </div>
  </section>


</Layout>

<style>
  /* ── HERO ── */
  .hero-section {
    min-height: 54vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    gap: 24px;
    padding: 36px 24px;
    box-sizing: border-box;
  }

  .hero-top {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .gild-logo {
    height: 42px;
    width: auto;
    filter: brightness(0) invert(1);
  }

  .hero-eyebrow {
    color: #7ec8b8;
    margin: 0;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-size: 12px;
    font-weight: 400;
  }

  .hero-center {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }

  .hero-title {
    font-family: 'Montserrat', sans-serif;
    font-weight: 300;
    font-size: clamp(1.8rem, 5.6vw, 4.4rem);
    line-height: 1.15;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-fg);
    margin: 0;
    max-width: 1000px;
  }

  .hero-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .hero-partner-label {
    color: var(--color-fg-muted);
    margin: 0;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-size: 14px;
    font-weight: 400;
  }

  .partner-link {
    display: inline-block;
    transition: opacity var(--duration-hover) var(--ease-entrance);
  }

  .partner-link:hover {
    opacity: 0.8;
  }

  .partner-logo {
    height: 44px;
    width: auto;
  }

  .hero-scroll-arrow {
    color: var(--color-fg-muted);
    margin-top: 12px;
    animation: hero-bounce 2s ease-in-out infinite;
    width: 28px;
    height: 28px;
  }

  @keyframes hero-bounce {
    0%, 100% { transform: translateY(0); opacity: 0.5; }
    50% { transform: translateY(8px); opacity: 0.9; }
  }

  /* ── INSTAGRAM — 3 × 3 grid ── */
  .ig-section {
    padding-top: 8px;
    padding-bottom: 0;
    padding-inline: 24px;
    box-sizing: border-box;
  }

  .ig-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding-top: 28px;
    margin: 0;
  }

  .ig-cta-copy {
    margin: 0;
    color: var(--color-fg);
    font-family: var(--font-body);
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    font-weight: 300;
    letter-spacing: 0.01em;
  }

  .ig-logo-cta {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    color: var(--color-accent);
    transition: color var(--duration-hover) var(--ease-entrance), transform var(--duration-hover) var(--ease-entrance);
  }

  .ig-logo-cta svg {
    width: 26px;
    height: 26px;
  }

  .ig-logo-cta:hover {
    color: var(--color-fg);
    transform: translateY(-2px);
  }

  .ig-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    width: 100%;
    max-width: 935px;
    margin: 0 auto;
  }

  .ig-post {
    display: block;
    aspect-ratio: 1080 / 1350;
    overflow: hidden;
    background: var(--color-surface, #111);
  }

  .ig-post img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.2s ease;
  }

  .ig-post:hover img {
    opacity: 0.82;
  }


  @media (min-width: 768px) {
    .ig-section {
      padding-top: 12px;
      padding-inline: 32px;
    }
  }

  /* ── NEXT EVENT WRAPPER (kept for reuse) ── */
  .next-event-wrapper {
    padding: 64px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
  }

  .next-event-header {
    max-width: 480px;
    margin: 0 auto;
    text-align: center;
  }

  .next-event-label,
  .next-event-city,
  .next-event-date {
    margin: 0;
  }

  .next-event-label {
    color: var(--color-accent);
    margin-bottom: 12px;
  }

  .next-event-city {
    color: var(--color-fg);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 300;
    letter-spacing: 0.01em;
  }

  .next-event-date {
    margin-top: 8px;
    color: var(--color-fg-muted);
    font-size: 14px;
    letter-spacing: 0.04em;
  }

  .next-event-content {
    width: 100%;
    max-width: 400px;
    margin: 0 auto;
  }

  .next-event-link {
    display: block;
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    transition: transform var(--duration-hover) var(--ease-entrance);
  }

  .next-event-link:hover {
    transform: scale(1.02);
  }

  .next-event-image {
    width: 100%;
    height: auto;
    display: block;
  }

  .next-event-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--duration-hover) var(--ease-entrance);
  }

  .next-event-link:hover .next-event-overlay {
    opacity: 1;
  }

  .text-button {
    color: white;
    font-family: var(--font-body);
    font-size: 14px;
    letter-spacing: 0.1em;
    font-weight: 500;
    padding: 12px 24px;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(4px);
  }

  /* ── Mobile: fit hero in 100vh ── */
  @media (max-width: 767px) {
    .hero-section {
      min-height: 58vh;
      min-height: 58dvh;
      padding: 36px 20px;
    }

    .hero-top {
      gap: 14px;
    }

    .gild-logo {
      height: 28px;
    }

    .hero-eyebrow {
      font-size: 10px;
    }

    .hero-center {
      padding: 20px 0;
    }

    .hero-title {
      font-size: 1.6rem;
    }

    .hero-bottom {
      gap: 8px;
    }

    .hero-partner-label {
      font-size: 9px;
    }

    .sponsor-logo {
      height: 28px;
    }

    .hero-scroll-arrow {
      margin-top: 16px;
      width: 22px;
      height: 22px;
    }
  }

  /* ── Desktop ── */
  @media (min-width: 768px) {
    .hero-section {
      min-height: 54vh;
      padding: 56px 64px;
    }
  }
</style>

<script>
  import { animateCoverTitle, animateFadeUp } from '../lib/gsap-utils';

  document.addEventListener('DOMContentLoaded', () => {
    // Hero Entrance
    animateCoverTitle('.hero-section', '.hero-line');
    animateFadeUp('.hero-section', '.hero-top, .hero-bottom', {
      stagger: 0.15,
      delay: 0.4,
    });

    animateFadeUp('.ig-section', '.ig-post', { stagger: 0.06 });
  });
</script>
